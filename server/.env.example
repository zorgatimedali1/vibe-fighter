# DEV_MODE=true: no chain, no wallet. Guests can fight each other or a bot. NEVER use with real money.
DEV_MODE=true
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Production (DEV_MODE=false)
RPC_URL=https://your-rpc
CHAIN_ID=8453
ESCROW_ADDRESS=0x0000000000000000000000000000000000000000
MIN_POT=2000000
CONFIRMATIONS=2
SERVER_SIGNER_PK=0x...   # key registered on the escrow as the result signer

# --- X (Twitter) sign-in + ranked ladder ---
# Create an OAuth 2.0 app at https://developer.x.com, enable "Read", and register this callback:
#   http://localhost:3000/auth/x/callback
# Leave X_CLIENT_ID empty to use the built-in mock identity (no X account needed locally).
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://localhost:3000/auth/x/callback
# Force the mock login even when credentials exist (demos / CI)
X_DEV_MOCK=false

# SQLite file holding players, matches and the ladder (created on first boot)
# DB_PATH=./data/voxel.db
