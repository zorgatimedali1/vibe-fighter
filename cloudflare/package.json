{
  "name": "vibe-fighter-cloudflare",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:init": "wrangler d1 execute vibe-fighter --local --file src/schema.sql",
    "db:init:remote": "wrangler d1 execute vibe-fighter --remote --file src/schema.sql --yes"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261104.1",
    "typescript": "^5.6.3",
    "wrangler": "^4.157.0"
  }
}
